    cameraLocalEulerAngles: {x: 30, y: -135, z: 0}
    speakerName: "\uCD0C\uC7A5"
    dialogueText: "\uC6B0\uB9AC \uB9C8\uC744 \uADFC\uCC98\uC758 \uBB3C\uC774 \uC911\uAE09\uC2AC\uB77C\uC784
