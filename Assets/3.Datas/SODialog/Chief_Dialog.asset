  - index: 1
    cameraLocalPosition: {x: 2, y: 3, z: 3}
    cameraLocalEulerAngles: {x: 30, y: -135, z: 0}
    speakerName: "\uCD0C\uC7A5"
    dialogueText: "\uC678\uBD80\uC778\uC774\uAD70. \uBB34\uC2A8 \uC77C\uC774\uC9C0?"
    onTalkStart:
      m_PersistentCalls:
        m_Calls: []
    playTalkAnimationOnStart: 1
    endsConversation: 0
    questToGrant: {fileID: 0}
    questToTurnIn: {fileID: 0}
    cutsceneToPlay: {fileID: 0}
    choices:
    - choiceText: "\uB9C8\uC744\uC758 \uC0C1\uD669\uC5D0 \uB300\uD574.."
      targetIndex: 2
      questToGrant: {fileID: 0}
      questToTurnIn: {fileID: 0}
      cutsceneToPlay: {fileID: 0}
  - index: 2
    cameraLocalPosition: {x: 2, y: 3, z: 3}
    cameraLocalEulerAngles: {x: 30, y: -135, z: 0}
    speakerName: "\uCD0C\uC7A5"
    dialogueText: "\uBB38\uC81C\uB97C \uD574\uACB0\uD574\uC8FC\uACA0\uB2E4\uACE0?
      \uC678\uBD80\uC778\uC5D0\uAC8C \uADF8\uB7F0\uC77C\uC744 \uB9E1\uAE38 \uC21C
      \uC5C6\uB2E4."
    onTalkStart:
      m_PersistentCalls:
        m_Calls: []
    playTalkAnimationOnStart: 0
    endsConversation: 0
    questToGrant: {fileID: 0}
    questToTurnIn: {fileID: 0}
    cutsceneToPlay: {fileID: 0}
    choices:
    - choiceText: "\uD55C \uBC88\uB9CC \uBBFF\uC5B4\uBD10\uC694."
      targetIndex: 3
      questToGrant: {fileID: 11400000, guid: ffaf13dc11e8db74bbab6745137e7620, type: 2}
      questToTurnIn: {fileID: 0}
      cutsceneToPlay: {fileID: 0}
  - index: 3
    cameraLocalPosition: {x: 2, y: 3, z: 3}
    cameraLocalEulerAngles: {x: 30, y: -135, z: 0}
    speakerName: "\uCD0C\uC7A5"
    dialogueText: "\uADF8\uB300\uC758 \uB73B\uC774 \uADF8\uB807\uB2E4\uBA74.. \uC6B0\uC120\uC740
      \uB9C8\uC744\uC0AC\uB78C\uB4E4\uC758 \uACE0\uBBFC\uC744 \uB4E4\uC5B4\uC8FC\uAC8C"
    onTalkStart:
      m_PersistentCalls:
        m_Calls: []
    playTalkAnimationOnStart: 0
    endsConversation: 1
    questToGrant: {fileID: 0}
    questToTurnIn: {fileID: 0}
    cutsceneToPlay: {fileID: 0}
    choices: []
  - index: 11
    cameraLocalPosition: {x: 2, y: 3, z: 3}
    cameraLocalEulerAngles: {x: 30, y: -135, z: 0}
    speakerName: "\uCD0C\uC7A5"
    dialogueText: "\uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC758 \uC2E0\uB8B0\uB97C \uC5BB\uACE0
      \uC624\uB3C4\uB85D."
    onTalkStart:
      m_PersistentCalls:
        m_Calls: []
    playTalkAnimationOnStart: 1
    endsConversation: 1
    questToGrant: {fileID: 0}
    questToTurnIn: {fileID: 0}
    cutsceneToPlay: {fileID: 0}
    choices: []
  - index: 21
    cameraLocalPosition: {x: 2, y: 3, z: 3}
    cameraLocalEulerAngles: {x: 30, y: -135, z: 0}
    speakerName: "\uCD0C\uC7A5"
    dialogueText: "\uC8FC\uBBFC\uB4E4\uC5D0\uAC8C \uC774\uC57C\uAE30\uB294 \uC798
      \uB4E4\uC5C8\uB124. \uC5B4\uB290\uC815\uB3C4 \uC2E4\uB825\uC774 \uC788\uB294\uAC83
      \uAC19\uAD70."
    onTalkStart:
      m_PersistentCalls:
        m_Calls: []
    playTalkAnimationOnStart: 1
    endsConversation: 0
    questToGrant: {fileID: 0}
    questToTurnIn: {fileID: 0}
    cutsceneToPlay: {fileID: 0}
    choices: []
  - index: 22
    cameraLocalPosition: {x: 2, y: 3, z: 3}
    cameraLocalEulerAngles: {x: 30, y: -135, z: 0}
    speakerName: "\uCD0C\uC7A5"
    dialogueText: "\uADF8\uB7FC \uB9C8\uC9C0\uB9C9\uC73C\uB85C \uBD80\uD0C1 \uD558\uB098\uB9CC
      \uD558\uC9C0."
    onTalkStart:
