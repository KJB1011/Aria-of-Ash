        m_Calls: []
    playTalkAnimationOnStart: 0
    endsConversation: 0
    questToGrant: {fileID: 0}
    questToTurnIn: {fileID: 0}
    cutsceneToPlay: {fileID: 0}
    choices:
    - choiceText: "\uB9E1\uACA8\uB9CC \uC8FC\uC138\uC694"
