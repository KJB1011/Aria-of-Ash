    cameraLocalEulerAngles: {x: 30, y: -135, z: 0}
    speakerName: "\uCD0C\uC7A5"
    dialogueText: "\uB9C8\uC744 \uC785\uAD6C \uC67C\uCABD\uC73C\uB85C \uB098\uAC00\uBA74
